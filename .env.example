# MongoDB must run as a replica set (transactions). Example for a local single-node replica set:
 MONGODB_URI=mongodb://localhost:27017/wms?replicaSet=rs0

 # Random secret that signs session cookies. At least 32 characters, e.g. openssl rand -base64 48
 AUTH_SECRET=

 # Public URL of the app (used in metadata)
 NEXT_PUBLIC_APP_URL=http://localhost:3000

 # Used only by npm run wms:setup to create the first administrator
 ADMIN_USERNAME=admin
 ADMIN_PASSWORD=

 # Local development only: skip the login screen and act as a fixed admin (ignored outside
 ext dev)
 # DEV_AUTH_BYPASS=true

 # Local development only: run on an in-memory database filled with fake data (no MongoDB needed).
 # Data is regenerated on every next dev start. Ignored outside next dev.
 # MOCK_DB=true